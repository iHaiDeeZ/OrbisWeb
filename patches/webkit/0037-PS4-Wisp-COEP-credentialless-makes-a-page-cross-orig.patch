From 6cd9956e65c15248ebb26035f118eb66327d1bd8 Mon Sep 17 00:00:00 2001
From: wisp <wisp@localhost>
Date: Wed, 25 Nov 2026 18:12:36 +0300
Subject: [PATCH] PS4 (Wisp): COEP credentialless makes a page cross-origin
 isolated

WebKit parses only Cross-Origin-Embedder-Policy: require-corp. Games served with
COOP same-origin and COEP credentialless (Emscripten builds with threads, which
need SharedArrayBuffer) found crossOriginIsolated false and refused to start
("Cannot load the game: Cross-origin isolated ... unavailable").

On __ORBIS__, credentialless is taken as require-corp: the document's COOP becomes
same-origin-plus-COEP and crossOriginIsolated true, for workers too. A cross-origin
no-cors load then needs a Cross-Origin-Resource-Policy header, where credentialless
would send it without credentials. WISP_COEP_CREDENTIALLESS=0 turns it off.
---
 .../loader/CrossOriginEmbedderPolicy.cpp      | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/Source/WebCore/loader/CrossOriginEmbedderPolicy.cpp b/Source/WebCore/loader/CrossOriginEmbedderPolicy.cpp
index f66d3cdb..b83086da 100644
--- a/Source/WebCore/loader/CrossOriginEmbedderPolicy.cpp
+++ b/Source/WebCore/loader/CrossOriginEmbedderPolicy.cpp
@@ -44,6 +44,11 @@
 #include <wtf/persistence/PersistentCoders.h>
 #include <wtf/text/MakeString.h>
 
+#if defined(__ORBIS__)
+#include <stdlib.h>
+#include <string.h>
+#endif
+
 namespace WebCore {
 
 // https://html.spec.whatwg.org/multipage/origin.html#obtain-an-embedder-policy
@@ -54,6 +59,23 @@ CrossOriginEmbedderPolicy obtainCrossOriginEmbedderPolicy(const ResourceResponse
         if (!coepParsingResult)
             return;
         auto* policyString = std::get_if<RFC8941::Token>(&coepParsingResult->first);
+#if defined(__ORBIS__)
+        // PS4 (Wisp): "credentialless" isolates too. WebKit knows only require-corp, and games served with
+        // COOP same-origin and COEP credentialless (Emscripten threads, SharedArrayBuffer) found
+        // crossOriginIsolated false. Taken as require-corp: a cross-origin no-cors load then needs a
+        // Cross-Origin-Resource-Policy header, where credentialless would send it without credentials.
+        // WISP_COEP_CREDENTIALLESS=0 (Settings) turns it off.
+        static const bool credentiallessIsolates = [] {
+            const char* setting = getenv("WISP_COEP_CREDENTIALLESS");
+            return !setting || strcmp(setting, "0");
+        }();
+        if (policyString && credentiallessIsolates && policyString->string() == "credentialless"_s) {
+            value = CrossOriginEmbedderPolicyValue::RequireCORP;
+            if (auto* reportToString = coepParsingResult->second.getIf<String>("report-to"_s))
+                reportingEndpoint = *reportToString;
+            return;
+        }
+#endif
         if (!policyString || policyString->string() != "require-corp"_s)
             return;
 
