From 077eb203dd69183abcf26ef0840225fa537ff766 Mon Sep 17 00:00:00 2001
From: wisp <wisp@localhost>
Date: Thu, 19 Nov 2026 21:15:21 +0300
Subject: [PATCH] PS4 (Wisp): the garbage collector helper threads stay once
 started

---
 Source/WTF/wtf/ParallelHelperPool.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Source/WTF/wtf/ParallelHelperPool.cpp b/Source/WTF/wtf/ParallelHelperPool.cpp
index 4e35368d..133f92be 100644
--- a/Source/WTF/wtf/ParallelHelperPool.cpp
+++ b/Source/WTF/wtf/ParallelHelperPool.cpp
@@ -181,7 +181,14 @@ class ParallelHelperPool::Thread final : public AutomaticThread {
     WTF_OVERRIDE_DELETE_FOR_CHECKED_PTR(Thread);
 public:
     Thread(const AbstractLocker& locker, ParallelHelperPool& pool)
+#if defined(__ORBIS__)
+        // PS4 (Wisp): helpers stay once started. Each one that ended after 10 s idle was started again
+        // at the next collection, and a thread the system cannot start then (the memory the app's
+        // processes share runs low) stops the web process (Thread::create's RELEASE_ASSERT, v00.10-11)
+        : AutomaticThread(locker, pool.m_lock, pool.m_workAvailableCondition.copyRef(), Seconds::infinity())
+#else
         : AutomaticThread(locker, pool.m_lock, pool.m_workAvailableCondition.copyRef())
+#endif
         , m_pool(pool)
     {
     }
-- 
