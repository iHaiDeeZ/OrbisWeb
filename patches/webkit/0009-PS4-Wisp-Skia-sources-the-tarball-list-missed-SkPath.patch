     src/core/SkPathBuilder.cpp
     src/core/SkPathData.cpp
     src/core/SkPathEffect.cpp
@@ -237,6 +238,7 @@ add_library(Skia STATIC
     src/core/SkSpriteBlitter_ARGB32.cpp
     src/core/SkStream.cpp
     src/core/SkStrike.cpp
+    src/core/SkStrikeRef.cpp
     src/core/SkStrikeCache.cpp
     src/core/SkStrikeSpec.cpp
     src/core/SkString.cpp
diff --git a/Source/WebKit/WPEPlatform/wpe/WPEProcessManager.cpp b/Source/WebKit/WPEPlatform/wpe/WPEProcessManager.cpp
index 2880c9bc..5aa9eaf5 100644
--- a/Source/WebKit/WPEPlatform/wpe/WPEProcessManager.cpp
+++ b/Source/WebKit/WPEPlatform/wpe/WPEProcessManager.cpp
@@ -26,7 +26,7 @@
 #include "config.h"
