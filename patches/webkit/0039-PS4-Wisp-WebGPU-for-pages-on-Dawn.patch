+// PS4 (Wisp): on Dawn's webgpu.h. Descriptors are built from Dawn's *_INIT values, so a field left alone keeps the
+// standard's meaning: in a bind group layout entry the kinds not used stay "BindingNotUsed" (WebKit's own C API
+// read "Undefined" that way; the standard reads it as "the default").
+
 namespace WebCore::WebGPU {
 
+// --- the device's callbacks ------------------------------------------------------------------------------------
+
+void DawnDeviceCallbacks::attach(WGPUDeviceDescriptor& descriptor)
+{
+    descriptor.deviceLostCallbackInfo.mode = WGPUCallbackMode_AllowProcessEvents;
+    descriptor.deviceLostCallbackInfo.callback = [](const WGPUDevice*, WGPUDeviceLostReason reason, WGPUStringView message, void* userdata1, void*) {
+        // Dawn's reference, taken back with its last callback
+        auto callbacks = adoptRef(*static_cast<DawnDeviceCallbacks*>(userdata1));
+        callbacks->deviceLost(reason, message);
+    };
+    ref();
+    descriptor.deviceLostCallbackInfo.userdata1 = this;
+    descriptor.uncapturedErrorCallbackInfo.callback = [](const WGPUDevice*, WGPUErrorType type, WGPUStringView message, void* userdata1, void*) {
+        static_cast<DawnDeviceCallbacks*>(userdata1)->uncapturedError(type, message);
+    };
+    descriptor.uncapturedErrorCallbackInfo.userdata1 = this;
+}
+
+void DawnDeviceCallbacks::setDeviceLostHandler(CompletionHandler<void(DeviceLostReason)>&& handler)
+{
+    if (m_lostReason) {
+        handler(*m_lostReason);
+        return;
+    }
+    m_lostHandler = WTF::move(handler);
+}
+
+void DawnDeviceCallbacks::setUncapturedErrorHandler(CompletionHandler<void(bool, std::optional<Error>&&)>&& handler)
+{
+    m_errorHandler = WTF::move(handler);
+}
+
+void DawnDeviceCallbacks::deviceLost(WGPUDeviceLostReason reason, WGPUStringView message)
+{
+    if (reason != WGPUDeviceLostReason_Destroyed && reason != WGPUDeviceLostReason_CallbackCancelled)
+        WTFLogAlways("WebGPU (Dawn): a device was lost (%d): %s", static_cast<int>(reason), fromDawnStringView(message).utf8().data());
+    auto lostReason = reason == WGPUDeviceLostReason_Destroyed ? DeviceLostReason::Destroyed : DeviceLostReason::Unknown;
+    m_lostReason = lostReason;
+    if (m_lostHandler)
+        m_lostHandler(lostReason);
+}
+
+static std::optional<Error> errorFromDawn(WGPUErrorType type, WGPUStringView message)
+{
+    switch (type) {
+    case WGPUErrorType_Validation:
+        return { { ValidationError::create(fromDawnStringView(message)) } };
+    case WGPUErrorType_OutOfMemory:
+        return { { OutOfMemoryError::create() } };
+    case WGPUErrorType_Internal:
+    case WGPUErrorType_Unknown:
+        return { { InternalError::create(fromDawnStringView(message)) } };
+    default:
+        return std::nullopt;
+    }
+}
+
+// (env WISP_WEBGPU_LOG=0: no error lines; the app's setting webgpu_log)
+static bool logDawnErrors()
+{
+    static const bool on = [] {
+        const char* value = getenv("WISP_WEBGPU_LOG");
+        return !value || strcmp(value, "0");
+    }();
+    return on;
+}
+
+void DawnDeviceCallbacks::uncapturedError(WGPUErrorType type, WGPUStringView message)
+{
+    if (m_paused)
+        return;
+    // the page's console never hears of them on this port (GPUDevice listens on Apple's systems only): web.log
+    // does, the first 40, then every 500th
+    if (logDawnErrors() && (m_errorsLogged < 40 || !(m_errorsLogged % 500)))
+        WTFLogAlways("WebGPU (Dawn): uncaptured %s error: %s", type == WGPUErrorType_Validation ? "validation" : type == WGPUErrorType_OutOfMemory ? "out-of-memory" : "internal", fromDawnStringView(message).utf8().data());
+    m_errorsLogged++;
+    if (m_errorHandler)
+        m_errorHandler(true, errorFromDawn(type, message));
+}
