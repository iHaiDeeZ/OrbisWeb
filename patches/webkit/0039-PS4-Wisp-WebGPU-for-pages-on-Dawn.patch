+
+// PS4 (Wisp): WebCore's WebGPU implementation on Dawn, the standard webgpu.h, instead of WebKit's WebGPU
+// framework (Metal, Apple's systems only). What every Implementation file needs: Dawn's API, labels and
+// messages as WGPUStringView, WTF callbacks carried through Dawn's userdata, and the event pump that delivers
+// Dawn's callbacks on the thread that owns the GPU object.
+
+#pragma once
+
+#if HAVE(WEBGPU_IMPLEMENTATION)
+
+#include <atomic>
+#include <cstring>
+#include <memory>
+#include <webgpu/webgpu.h>
+#include <wtf/Condition.h>
+#include <wtf/Function.h>
+#include <wtf/Lock.h>
+#include <wtf/Ref.h>
+#include <wtf/RefPtr.h>
+#include <wtf/Threading.h>
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/text/CString.h>
+#include <wtf/text/WTFString.h>
+
+namespace WebCore::WebGPU {
+
+// A label or message for Dawn; the CString must outlive the call
+inline WGPUStringView dawnStringView(const CString& string)
+{
+    return WGPUStringView { string.data(), string.length() };
+}
+
+inline String fromDawnStringView(WGPUStringView view)
+{
+    if (!view.data)
+        return { };
+    size_t length = view.length == WGPU_STRLEN ? strlen(view.data) : view.length;
+    return String::fromUTF8(std::span<const char> { view.data, length });
+}
+
+// A WTF callable kept on the heap while Dawn holds it as userdata1
+template<typename Callable>
+void* boxCallback(Callable&& callable)
+{
+    return new std::decay_t<Callable>(std::forward<Callable>(callable));
+}
+
+template<typename Callable>
+std::unique_ptr<Callable> unboxCallback(void* userdata)
+{
+    return std::unique_ptr<Callable>(static_cast<Callable*>(userdata));
+}
+
+// Dawn delivers callbacks made with WGPUCallbackMode_AllowProcessEvents inside wgpuInstanceProcessEvents,
+// which also ticks the devices (finished GPU work, buffer maps, lost devices). WebKit wants them on the
+// thread that owns the GPU object (the page's main thread, or a worker's). While anything waits for one (a
+// device alive counts), a helper thread posts wgpuInstanceProcessEvents to that thread through WebKit's
+// schedule-work function, at most every 2 ms.
+class DawnEventPump : public ThreadSafeRefCounted<DawnEventPump> {
+public:
+    using Schedule = Function<void(Function<void()>&&)>;
+    static Ref<DawnEventPump> create(WGPUInstance instance, Schedule&& schedule)
+    {
+        return adoptRef(*new DawnEventPump(instance, WTF::move(schedule)));
+    }
+
+    ~DawnEventPump();
+
+    WGPUInstance instance() const { return m_instance; }
+
+    // An async call or a device starts waiting for callbacks; end() when it no longer does
+    void begin();
+    void end();
+    // The GPU object goes: no more processing (the instance is released after)
+    void stop();
+
+private:
+    DawnEventPump(WGPUInstance, Schedule&&);
+    void loop();
+    void process();
+
+    WGPUInstance m_instance;
+    Schedule m_schedule;
+    Lock m_lock;
+    Condition m_condition;
+    unsigned m_pending WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    bool m_posted WTF_GUARDED_BY_LOCK(m_lock) { false };
+    bool m_stopped WTF_GUARDED_BY_LOCK(m_lock) { false };
+    RefPtr<Thread> m_thread;
+};
+
+// An async call's WTF callable while Dawn holds it as userdata1: the pump keeps processing events until it is
+// gone (Dawn calls every callback once, a cancelled one too, so the box is always taken back)
+template<typename Handler>
+struct PendingCallback {
+    WTF_MAKE_NONCOPYABLE(PendingCallback);
+public:
+    PendingCallback(DawnEventPump* pump, Handler&& handler)
+        : m_pump(pump)
+        , m_handler(WTF::move(handler))
+    {
+        if (m_pump)
+            m_pump->begin();
+    }
+
+    ~PendingCallback()
+    {
+        if (m_pump)
+            m_pump->end();
+    }
+
+    Handler& handler() { return m_handler; }
+
+private:
+    RefPtr<DawnEventPump> m_pump;
+    Handler m_handler;
+};
+
+template<typename Handler>
+void* pendingCallback(DawnEventPump* pump, Handler&& handler)
+{
+    return new PendingCallback<std::decay_t<Handler>>(pump, std::forward<Handler>(handler));
+}
+
+template<typename Handler>
+std::unique_ptr<PendingCallback<Handler>> takePendingCallback(void* userdata)
+{
+    return std::unique_ptr<PendingCallback<Handler>>(static_cast<PendingCallback<Handler>*>(userdata));
+}
+
+} // namespace WebCore::WebGPU
