+// PS4 (Wisp): WebGPU canvases on Dawn, without Apple's IOSurfaces (their context isn't in WPE's sources). The
+// canvas's textures are its presentation context's own (WebGPUPresentationContextImpl). At the rendering update
+// after the page drew, the frame is presented, which reads it back; once it is back it goes to the canvas's
+// compositing layer as an image (CoordinatedPlatformLayerBufferNativeImage), or, when the canvas has no layer, into
+// the buffer the canvas element paints.
+class GPUCanvasContextWisp final : public GPUCanvasContext {
+    WTF_MAKE_TZONE_ALLOCATED(GPUCanvasContextWisp);
+public:
+    GPUCanvasContextWisp(CanvasBase& canvas, Ref<GPUCompositorIntegration>&& compositorIntegration, Ref<GPUPresentationContext>&& presentationContext)
+        : GPUCanvasContext(canvas)
+        , m_compositorIntegration(WTF::move(compositorIntegration))
+        , m_presentationContext(WTF::move(presentationContext))
+        , m_layerDelegate(GraphicsLayerContentsDisplayDelegateCoordinated::create())
+    {
+        presentationImpl().setFrameReadyCallback([weakThis = WeakPtr<CanvasRenderingContext> { *this }] {
+            if (RefPtr protectedThis = weakThis.get())
+                static_cast<GPUCanvasContextWisp&>(*protectedThis).frameReady();
+        });
+    }
+
+    ~GPUCanvasContextWisp()
+    {
+        presentationImpl().setFrameReadyCallback(nullptr);
+    }
+
+    // CanvasRenderingContext
+    bool compositingResultsNeedUpdating() const final { return m_compositingResultsNeedUpdating; }
+    bool needsPreparationForDisplay() const final { return true; }
+    void prepareForDisplay() final;
+    RefPtr<GraphicsLayerContentsDisplayDelegate> layerContentsDisplayDelegate() final { return m_layerDelegate.ptr(); }
+    void didUpdateCanvasSizeProperties(bool sizeChanged) final;
+    RefPtr<ImageBuffer> surfaceBufferToImageBuffer(SurfaceBuffer) final;
+    bool isSurfaceBufferTransparentBlack(SurfaceBuffer) const final { return false; }
+    RefPtr<ImageBuffer> transferToImageBuffer() final { return surfaceBufferToImageBuffer(SurfaceBuffer::DisplayBuffer); }
+    bool isOpaque() const final { return m_configuration && m_configuration->alphaMode == GPUCanvasAlphaMode::Opaque; }
+
+    // GPUCanvasContext
+    CanvasType canvas() final;
+    ExceptionOr<void> configure(GPUCanvasConfiguration&&) final;
+    void unconfigure() final;
+    std::optional<GPUCanvasConfiguration> getConfiguration() const final { return m_configuration; }
+    ExceptionOr<Ref<GPUTexture>> getCurrentTexture() final;
+
+private:
+    WebGPU::PresentationContextImpl& presentationImpl() { return downcast<WebGPU::PresentationContextImpl>(m_presentationContext->backing()); }
+    IntSize canvasSize() const;
+    void frameReady();
+
+    const Ref<GPUCompositorIntegration> m_compositorIntegration;
+    const Ref<GPUPresentationContext> m_presentationContext;
+    const Ref<GraphicsLayerContentsDisplayDelegate> m_layerDelegate;
+    std::optional<GPUCanvasConfiguration> m_configuration;
+    RefPtr<GPUTexture> m_currentTexture;
+    RefPtr<ImageBuffer> m_displayBuffer;
+    uint32_t m_frameIndex { 0 };
+    bool m_compositingResultsNeedUpdating { false };
+    bool m_displayBufferStale { true };
+};
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(GPUCanvasContextWisp);
+
+IntSize GPUCanvasContextWisp::canvasSize() const
+{
+    auto size = canvasBase().size();
+    return { std::max(1, size.width()), std::max(1, size.height()) };
+}
+
+GPUCanvasContext::CanvasType GPUCanvasContextWisp::canvas()
+{
+    Ref base = canvasBase();
+    if (RefPtr element = dynamicDowncast<HTMLCanvasElement>(base.get()))
+        return element.releaseNonNull();
+#if ENABLE(OFFSCREEN_CANVAS)
+    return Ref { downcast<OffscreenCanvas>(base.get()) };
+#else
+    RELEASE_ASSERT_NOT_REACHED();
+#endif
+}
+
+ExceptionOr<void> GPUCanvasContextWisp::configure(GPUCanvasConfiguration&& configuration)
+{
+    switch (configuration.format) {
+    case GPUTextureFormat::Bgra8unorm:
+    case GPUTextureFormat::Rgba8unorm:
+    case GPUTextureFormat::Rgba16float:
+        break;
+    default:
+        return Exception { ExceptionCode::TypeError, "GPUCanvasContext.configure: the format is not a canvas format (bgra8unorm, rgba8unorm or rgba16float)."_s };
+    }
+    auto size = canvasSize();
+    if (!m_presentationContext->configure(configuration, size.width(), size.height(), true))
+        return Exception { ExceptionCode::InvalidStateError, "GPUCanvasContext.configure: the canvas could not be configured."_s };
+    presentationImpl().setSize(size.width(), size.height());
+    m_configuration = WTF::move(configuration);
+    m_currentTexture = nullptr;
+    return { };
+}
+
+void GPUCanvasContextWisp::unconfigure()
+{
+    m_presentationContext->unconfigure();
+    m_configuration = std::nullopt;
+    m_currentTexture = nullptr;
+}
+
+ExceptionOr<Ref<GPUTexture>> GPUCanvasContextWisp::getCurrentTexture()
+{
+    if (!m_configuration)
+        return Exception { ExceptionCode::InvalidStateError, "GPUCanvasContext.getCurrentTexture: the canvas is not configured."_s };
+    if (!m_currentTexture) {
+        m_currentTexture = m_presentationContext->getCurrentTexture(m_frameIndex);
+        if (!m_currentTexture)
+            return Exception { ExceptionCode::OperationError, "GPUCanvasContext.getCurrentTexture: no texture for the canvas."_s };
+        // presented at the next rendering update (prepareForDisplay)
+        m_compositingResultsNeedUpdating = true;
+        markCanvasChanged();
+    }
+    return Ref { *m_currentTexture };
+}
+
+void GPUCanvasContextWisp::didUpdateCanvasSizeProperties(bool sizeChanged)
+{
+    if (!sizeChanged || !m_configuration)
+        return;
+    auto size = canvasSize();
+    if (m_presentationContext->configure(*m_configuration, size.width(), size.height(), true))
+        presentationImpl().setSize(size.width(), size.height());
+    m_currentTexture = nullptr;
+    m_displayBuffer = nullptr;
+}
+
+void GPUCanvasContextWisp::prepareForDisplay()
+{
+    if (!m_compositingResultsNeedUpdating)
+        return;
+    m_compositingResultsNeedUpdating = false;
+    if (!m_configuration)
+        return;
+    // the integration presents (reads back) the current texture; the DOM's context then lets it go
+    m_compositorIntegration->prepareForDisplay(m_frameIndex, [] { });
+    m_presentationContext->present(m_frameIndex);
+    m_currentTexture = nullptr;
+    ++m_frameIndex;
+}
+
+void GPUCanvasContextWisp::frameReady()
+{
+    if (RefPtr image = presentationImpl().displayImage())
+        m_layerDelegate->setDisplayBuffer(CoordinatedPlatformLayerBufferNativeImage::create(image.releaseNonNull(), nullptr));
+    m_displayBufferStale = true;
+    markCanvasChanged();
+}
+
+RefPtr<ImageBuffer> GPUCanvasContextWisp::surfaceBufferToImageBuffer(SurfaceBuffer)
+{
+    auto size = canvasSize();
+    if (!m_displayBuffer || m_displayBuffer->truncatedLogicalSize() != size) {
+        m_displayBuffer = ImageBuffer::create(size, RenderingMode::Unaccelerated, RenderingPurpose::Canvas, 1, DestinationColorSpace::SRGB(), PixelFormat::BGRA8);
+        m_displayBufferStale = true;
+    }
+    if (m_displayBuffer && m_displayBufferStale) {
+        m_compositorIntegration->paintCompositedResultsToCanvas(*m_displayBuffer, m_frameIndex);
+        m_displayBufferStale = false;
+    }
+    return m_displayBuffer;
+}
+
+std::unique_ptr<GPUCanvasContext> GPUCanvasContext::create(CanvasBase& canvas, GPU& gpu, Document*)
+{
+    RefPtr compositorIntegration = gpu.createCompositorIntegration();
+    if (!compositorIntegration)
+        return nullptr;
+    RefPtr presentationContext = gpu.createPresentationContext(GPUPresentationContextDescriptor { *compositorIntegration });
+    if (!presentationContext)
+        return nullptr;
+    // (the canvas owns its context: a unique_ptr, as Apple's context is made)
+    auto context = std::unique_ptr<GPUCanvasContextWisp>(new GPUCanvasContextWisp(canvas, compositorIntegration.releaseNonNull(), presentationContext.releaseNonNull()));
+    context->suspendIfNeeded();
+    return context;
+}
