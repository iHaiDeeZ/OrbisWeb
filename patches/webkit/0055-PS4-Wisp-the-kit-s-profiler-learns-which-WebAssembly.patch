From bb524f6305a1b90a97417e91f5508447706efbf6 Mon Sep 17 00:00:00 2001
From: wisp <wisp@localhost>
Date: Thu, 26 Nov 2026 18:46:13 +0300
Subject: [PATCH] PS4 (Wisp): the kit's profiler learns which WebAssembly
 function is hot

The kit's hot-spot profiler put compiled code in 16-byte buckets of raw
addresses: Star Fox 64's main thread spent two thirds of its running time in
JIT code (v00.45) with no way to tell which functions, or whether they ran on
BBQ or OMG while 30 of them were too large for OMG.

ps4_jit_owner (C linkage, the kit's weak reference; WasmCallee.cpp) looks an
address up in NativeCalleeRegistry, under its lock: the WebAssembly function's
index, its tier (CompilationMode) in the top byte, and the code's start. JIT
callees register only once their code is set, so the range is there.
---
 Source/JavaScriptCore/wasm/WasmCallee.cpp | 27 +++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/Source/JavaScriptCore/wasm/WasmCallee.cpp b/Source/JavaScriptCore/wasm/WasmCallee.cpp
index a8e10e52..103a7263 100644
--- a/Source/JavaScriptCore/wasm/WasmCallee.cpp
+++ b/Source/JavaScriptCore/wasm/WasmCallee.cpp
@@ -624,6 +624,33 @@ WasmBuiltinCallee::WasmBuiltinCallee(const WebAssemblyBuiltin* builtin, std::pai
     m_trampoline = m_builtin->wasmTrampoline();
 }
 
+#if defined(__ORBIS__) && ENABLE(JIT)
+// PS4 (Wisp): the kit's hot-spot profiler (ps4-kit runtime/ps4_sampler.cpp) asks which compiled code an address
+// belongs to, from its own thread: here the WebAssembly function's index, its tier (CompilationMode: BBQ 1, OMG 2,
+// OMG for OSR entry 3, ...) in the top byte, and the code's start. JIT callees register once their code is set, and
+// unregister under the same lock, so their range is there while the lock is held. (C linkage: the kit's weak
+// reference finds it.)
+extern "C" int ps4_jit_owner(uint64_t rip, uint32_t* guestStart, uint64_t* hostStart)
+{
+    auto& registry = NativeCalleeRegistry::singleton();
+    Locker locker { registry.getLock() };
+    for (NativeCallee* native : registry.allCallees()) {
+        if (native->category() != NativeCallee::Category::Wasm)
+            continue;
+        auto* callee = static_cast<Callee*>(native);
+        auto [start, end] = callee->range();
+        const auto from = reinterpret_cast<uint64_t>(start);
+        const auto to = reinterpret_cast<uint64_t>(end);
+        if (!from || rip < from || rip >= to)
+            continue;
+        *guestStart = (static_cast<uint32_t>(callee->compilationMode()) << 24) | (callee->index().rawIndex() & 0xffffff);
+        *hostStart = from;
+        return 1;
+    }
+    return 0;
+}
+#endif
+
 } // namespace JSC::Wasm
 
 WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
