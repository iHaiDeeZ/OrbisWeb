 }
 
-void RenderBundleEncoderImpl::setBindGroup(Index32, const BindGroup*,
-    std::span<const uint32_t>,
-    Size64,
-    Size32)
+void RenderBundleEncoderImpl::setBindGroup(Index32 index, const BindGroup* bindGroup,
+    std::span<const uint32_t> dynamicOffsetsArrayBuffer,
+    Size64 dynamicOffsetsDataStart,
+    Size32 dynamicOffsetsDataLength)
 {
-    RELEASE_ASSERT_NOT_REACHED();
+    // PS4 (Wisp): the typed-array form, called here directly: WebKit's own WebGPU reaches this layer only
+    // through its GPU process, which turns the array into a Vector first, so upstream left this one
+    // unreachable (RELEASE_ASSERT_NOT_REACHED). A page passing its dynamic offsets in a Uint32Array
+    // aborted the web process (v00.42: Mortal Kombat's WebGPU page, twice). GPUComputePassEncoder and
+    // the others checked start + length against the array's length already.
+    auto offsets = dynamicOffsetsArrayBuffer.subspan(static_cast<size_t>(dynamicOffsetsDataStart), dynamicOffsetsDataLength);
+    wgpuRenderBundleEncoderSetBindGroup(m_backing.get(), index, bindGroup ? m_convertToBackingContext->convertToBacking(*bindGroup) : nullptr, offsets.size(), offsets.data());
 }
 
 void RenderBundleEncoderImpl::pushDebugGroup(String&& groupLabel)
diff --git a/Source/WebCore/Modules/WebGPU/Implementation/WebGPURenderPassEncoderImpl.cpp b/Source/WebCore/Modules/WebGPU/Implementation/WebGPURenderPassEncoderImpl.cpp
index 0b1014ba..320d842b 100644
--- a/Source/WebCore/Modules/WebGPU/Implementation/WebGPURenderPassEncoderImpl.cpp
+++ b/Source/WebCore/Modules/WebGPU/Implementation/WebGPURenderPassEncoderImpl.cpp
@@ -94,9 +94,15 @@ void RenderPassEncoderImpl::setBindGroup(Index32 index, const BindGroup* bindGro
     wgpuRenderPassEncoderSetBindGroup(m_backing.get(), index, bindGroup ? m_convertToBackingContext->convertToBacking(*bindGroup) : nullptr, backingOffsets.size(), backingOffsets.span().data());
 }
 
-void RenderPassEncoderImpl::setBindGroup(Index32, const BindGroup*, std::span<const uint32_t>, Size64, Size32)
-{
-    RELEASE_ASSERT_NOT_REACHED();
+void RenderPassEncoderImpl::setBindGroup(Index32 index, const BindGroup* bindGroup, std::span<const uint32_t> dynamicOffsetsArrayBuffer, Size64 dynamicOffsetsDataStart, Size32 dynamicOffsetsDataLength)
+{
+    // PS4 (Wisp): the typed-array form, called here directly: WebKit's own WebGPU reaches this layer only
+    // through its GPU process, which turns the array into a Vector first, so upstream left this one
+    // unreachable (RELEASE_ASSERT_NOT_REACHED). A page passing its dynamic offsets in a Uint32Array
+    // aborted the web process (v00.42: Mortal Kombat's WebGPU page, twice). GPUComputePassEncoder and
+    // the others checked start + length against the array's length already.
+    auto offsets = dynamicOffsetsArrayBuffer.subspan(static_cast<size_t>(dynamicOffsetsDataStart), dynamicOffsetsDataLength);
+    wgpuRenderPassEncoderSetBindGroup(m_backing.get(), index, bindGroup ? m_convertToBackingContext->convertToBacking(*bindGroup) : nullptr, offsets.size(), offsets.data());
 }
 
 void RenderPassEncoderImpl::pushDebugGroup(String&& groupLabel)
