+++ b/Source/WTF/wtf/ps4/MemoryPS4.cpp
@@ -9,6 +9,9 @@
  *   wisp_memory_footprint()  bytes this process has allocated now (heaps + JS)
  *   wisp_memory_budget()     bytes this process should stay under
  *
+ * WebKit's own pages (ps4/OSAllocatorPS4.cpp: JSC's structure heap and the like, in direct memory
+ * outside the kit's heaps since Wisp v00.17) are added to the footprint here.
+ *
  * The defaults here are weak; the app defines both (ports/wisp/runtime).
  */
 
@@ -29,13 +32,15 @@ __attribute__((weak)) size_t wisp_memory_budget(void)
     return static_cast<size_t>(1536) << 20;
 }
 
+size_t wtf_ps4_page_memory(size_t* held);
+
 }
 
