+// Direct memory WebKit's pages use now, and what this allocator holds of it (`held`; may be null):
+// ps4/MemoryPS4.cpp and the app's memory lines
+extern "C" size_t wtf_ps4_page_memory(size_t* held)
+{
+    if (held) {
+        Locker locker { poolLock };
+        *held = static_cast<size_t>(blockCount) * blockSize;
+    }
+    return pagesInUse.load(std::memory_order_relaxed) * kernelPage;
+}
+
 } // namespace WTF
