From f3ff5633bfd74b285545f8ac3c2646241f23a982 Mon Sep 17 00:00:00 2001
From: wisp <wisp@localhost>
Date: Fri, 20 Nov 2026 05:57:04 +0300
Subject: [PATCH] PS4 (Wisp): every page in the one web process; a process the
 PS4 does not start ends its pages, not the app

v00.20 ended at a YouTube navigation: its Cross-Origin-Opener-Policy header made WebKit switch
browsing context groups, processForSite passed over the one web process because it ran service
workers, and the PS4 refused a second web process (0x80aa001a: no room in the shared memory pool
for another program image). ProcessLauncherGLib then called g_error, which ended the app.

- ProcessLauncherGLib: a local process the PS4 does not start is a launch without a connection
  (the process ended, its pages are told), with a warning, instead of g_error.
- processForSite, single-process mode: the one process even while it runs service workers or is
  cross-origin isolated.
- A COOP switch to an isolated group uses the shared process in single-process mode.
---
 .../UIProcess/Launcher/glib/ProcessLauncherGLib.cpp | 13 +++++++++++--
 Source/WebKit/UIProcess/WebPageProxy.cpp            |  8 +++++++-
 Source/WebKit/UIProcess/WebProcessPool.cpp          |  7 +++++++
 3 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/Source/WebKit/UIProcess/Launcher/glib/ProcessLauncherGLib.cpp b/Source/WebKit/UIProcess/Launcher/glib/ProcessLauncherGLib.cpp
index 8628cd75..4fdadd0a 100644
--- a/Source/WebKit/UIProcess/Launcher/glib/ProcessLauncherGLib.cpp
+++ b/Source/WebKit/UIProcess/Launcher/glib/ProcessLauncherGLib.cpp
@@ -138,8 +138,17 @@ void ProcessLauncher::launchProcess()
         GUniqueOutPtr<GError> error;
         m_processID = wpe_process_manager_launch(processManager, options, &error.outPtr());
         wpe_process_launch_options_free(options);
-        if (!m_processID)
-            g_error("Unable to spawn a new child process: %s", error ? error->message : "unknown error");
+        if (!m_processID) {
+            // PS4 (Wisp): the system can refuse a local process (0x80aa001a with too little of the app's
+            // shared memory pool left for another program image, 0x80aa0008 with seven running). g_error
+            // would end the UI process and the app with it (v00.20, a YouTube navigation): a launch
+            // without a connection is a process that ended, which its pages are told about.
+            g_warning("Unable to spawn a new child process: %s", error ? error->message : "unknown error");
+            RunLoop::mainSingleton().dispatch([protectedThis = protect(*this), this] mutable {
+                didFinishLaunchingProcess(0, IPC::Connection::Identifier { });
+            });
+            return;
+        }
 
         // We've finished launching the process, message back to the main run loop.
         RunLoop::mainSingleton().dispatch([protectedThis = protect(*this), this, serverSocket = WTF::move(webkitSocketPair.server)] mutable {
diff --git a/Source/WebKit/UIProcess/WebPageProxy.cpp b/Source/WebKit/UIProcess/WebPageProxy.cpp
index f9bf536d..b53eb61e 100644
--- a/Source/WebKit/UIProcess/WebPageProxy.cpp
+++ b/Source/WebKit/UIProcess/WebPageProxy.cpp
@@ -10486,7 +10486,13 @@ void WebPageProxy::triggerBrowsingContextGroupSwitchForNavigation(WebCore::Navig
     auto enhancedSecurity = provisionalPage ? provisionalPage->process().enhancedSecurity() : m_legacyMainFrameProcess->enhancedSecurity();
 
     Ref processForNavigation = [&]() -> Ref<WebProcessProxy> {
-        if (browsingContextGroupSwitchDecision == BrowsingContextGroupSwitchDecision::NewIsolatedGroup) {
+        bool isolatedProcess = browsingContextGroupSwitchDecision == BrowsingContextGroupSwitchDecision::NewIsolatedGroup;
+#if defined(__ORBIS__)
+        // PS4 (Wisp): one web process for every page (patch 0006)
+        if (protect(m_configuration->processPool())->usesSingleWebProcess())
+            isolatedProcess = false;
+#endif
+        if (isolatedProcess) {
             auto enableWebAssemblyDebugger = protect(m_configuration->preferences())->webAssemblyDebuggerEnabled() ? WebProcessProxy::EnableWebAssemblyDebugger::Yes : WebProcessProxy::EnableWebAssemblyDebugger::No;
             return protect(m_configuration->processPool())->createNewWebProcess(protect(websiteDataStore()).ptr(), lockdownMode, enhancedSecurity, enableWebAssemblyDebugger, WebProcessProxy::IsPrewarmed::No, CrossOriginMode::Isolated, WebKit::jscOptionsForWebProcess(protect(m_configuration->preferences())->store(), lockdownMode == WebProcessProxy::LockdownMode::Enabled));
         }
diff --git a/Source/WebKit/UIProcess/WebProcessPool.cpp b/Source/WebKit/UIProcess/WebProcessPool.cpp
index 46574061..1ae01020 100644
--- a/Source/WebKit/UIProcess/WebProcessPool.cpp
+++ b/Source/WebKit/UIProcess/WebProcessPool.cpp
@@ -1317,10 +1317,17 @@ Ref<WebProcessProxy> WebProcessPool::processForSite(WebsiteDataStore& websiteDat
         for (Ref process : m_processes) {
             if (process->isPrewarmed() || process->isDummyProcessProxy())
                 continue;
+#if !defined(__ORBIS__)
             if (process->isRunningServiceWorkers())
                 continue;
             if (process->crossOriginMode() != CrossOriginMode::Shared)
                 continue;
+#else
+            // PS4 (Wisp): one web process for everything (patch 0006); a second does not fit in the
+            // app's shared memory pool, and the PS4 refuses to start it
+            if (process->state() == WebProcessProxy::State::Terminated)
+                continue;
+#endif
             if (mustMatchDataStore && process->websiteDataStore() != &websiteDataStore)
                 continue;
             return process;
