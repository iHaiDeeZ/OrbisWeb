diff --git a/Source/WTF/wtf/ps4/MemoryPS4.cpp b/Source/WTF/wtf/ps4/MemoryPS4.cpp
new file mode 100644
index 00000000..d35ae834
--- /dev/null
+++ b/Source/WTF/wtf/ps4/MemoryPS4.cpp
@@ -0,0 +1,48 @@
+/*
+ * PS4 (Wisp): memory figures for WebKit's caches and memory-pressure handling.
+ *
+ * On the PS4 there is no /proc, musl's sysinfo() is a Linux system call (another call on the
+ * PS4's FreeBSD kernel), and the kernel's struct kinfo_proc layout is not public. The app knows
+ * better anyway: every process allocates from the kit's heaps in direct memory, and the app
+ * decides each process's share of the PS4's memory. So WebKit asks the app:
+ *
+ *   wisp_memory_footprint()  bytes this process has allocated now (heaps + JS)
+ *   wisp_memory_budget()     bytes this process should stay under
+ *
+ * The defaults here are weak; the app defines both (ports/wisp/runtime).
+ */
+
+#include "config.h"
+
+#include <wtf/ProcessMemoryStatus.h>
+#include <wtf/linux/CurrentProcessMemoryStatus.h>
+
+extern "C" {
+
+__attribute__((weak)) size_t wisp_memory_footprint(void)
+{
+    return 0;
+}
+
+__attribute__((weak)) size_t wisp_memory_budget(void)
+{
+    return static_cast<size_t>(1536) << 20;
+}
+
+}
+
+namespace WTF {
+
+void currentProcessMemoryStatus(ProcessMemoryStatus& memoryStatus)
+{
+    size_t footprint = wisp_memory_footprint();
+    memoryStatus.size = footprint;
+    memoryStatus.resident = footprint;
+    memoryStatus.shared = 0;
+    memoryStatus.text = 0;
+    memoryStatus.lib = 0;
+    memoryStatus.data = footprint;
+    memoryStatus.dt = 0;
+}
+
+} // namespace WTF
diff --git a/Source/WTF/wtf/unix/MemoryPressureHandlerUnix.cpp b/Source/WTF/wtf/unix/MemoryPressureHandlerUnix.cpp
index 97b0e3de..fbaf5dff 100644
--- a/Source/WTF/wtf/unix/MemoryPressureHandlerUnix.cpp
+++ b/Source/WTF/wtf/unix/MemoryPressureHandlerUnix.cpp
@@ -35,7 +35,7 @@
 #include <wtf/MemoryFootprint.h>
 #include <wtf/text/WTFString.h>
 
-#if OS(LINUX)
+#if OS(LINUX) || defined(__ORBIS__) // PS4 (Wisp): wtf/ps4/MemoryPS4.cpp
 #include <wtf/linux/CurrentProcessMemoryStatus.h>
 #elif OS(HAIKU)
 #include <wtf/haiku/CurrentProcessMemoryStatus.h>
@@ -114,7 +114,7 @@ void MemoryPressureHandler::holdOff(Seconds seconds)
 
 static size_t processMemoryUsage()
 {
-#if OS(LINUX) || OS(HAIKU)
+#if OS(LINUX) || OS(HAIKU) || defined(__ORBIS__)
     ProcessMemoryStatus memoryStatus;
     currentProcessMemoryStatus(memoryStatus);
     return (memoryStatus.resident - memoryStatus.shared);
@@ -170,7 +170,7 @@ void MemoryPressureHandler::platformReleaseMemory(Critical)
 
 std::optional<MemoryPressureHandler::ReliefLogger::MemoryUsage> MemoryPressureHandler::ReliefLogger::platformMemoryUsage()
 {
-#if OS(LINUX) || OS(HAIKU)
+#if OS(LINUX) || OS(HAIKU) || defined(__ORBIS__)
     ProcessMemoryStatus memoryStatus;
     currentProcessMemoryStatus(memoryStatus);
     return MemoryUsage { memoryStatus.resident - memoryStatus.shared, memoryStatus.resident };
