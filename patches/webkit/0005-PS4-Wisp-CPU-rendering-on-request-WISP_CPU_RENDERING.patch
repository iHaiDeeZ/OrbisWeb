From 12dc4e29219579df79932a322f80ec4a7e2c3481 Mon Sep 17 00:00:00 2001
From: wisp <wisp@localhost>
Date: Tue, 17 Nov 2026 19:58:18 +0300
Subject: [PATCH 05/12] PS4 (Wisp): CPU rendering on request
 (WISP_CPU_RENDERING), as GTK hardware-acceleration policy NEVER

---
 Source/WebKit/UIProcess/API/glib/WebKitSettings.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/Source/WebKit/UIProcess/API/glib/WebKitSettings.cpp b/Source/WebKit/UIProcess/API/glib/WebKitSettings.cpp
index 298508fc..fde4c6ec 100644
--- a/Source/WebKit/UIProcess/API/glib/WebKitSettings.cpp
+++ b/Source/WebKit/UIProcess/API/glib/WebKitSettings.cpp
@@ -209,6 +209,17 @@ static void webKitSettingsConstructed(GObject* object)
     WebKitSettings* settings = WEBKIT_SETTINGS(object);
     [[maybe_unused]] RefPtr prefs = settings->priv->preferences.get();
 
+#if defined(__ORBIS__)
+    // PS4 (Wisp): pages painted and composed on the CPU (Skia) into shared memory, no GL, when the
+    // app asks (the policy setting is GTK-only API): GTK's HARDWARE_ACCELERATION_POLICY_NEVER.
+    if (const char* cpu = getenv("WISP_CPU_RENDERING"); cpu && strcmp(cpu, "0")) {
+        prefs->setHardwareAccelerationEnabled(false);
+        prefs->setAcceleratedCompositingEnabled(false);
+        prefs->setForceCompositingMode(false);
+        prefs->setThreadedScrollingEnabled(false);
+    }
+#endif
+
     // FIXME: Expose API for MediaSession when the feature is officially non-experimental.
 }
 
