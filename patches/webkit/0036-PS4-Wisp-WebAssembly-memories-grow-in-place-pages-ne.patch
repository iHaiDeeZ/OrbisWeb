             return 0;
-        }
         first = 0;
         length = limit;
     }
@@ -475,6 +471,12 @@ bool returnDirectMemory(uintptr_t begin, uintptr_t end)
     return all;
 }
 
+size_t wtf_ps4_page_memory_held()
+{
+    Locker locker { poolLock };
+    return static_cast<size_t>(blockCount) * blockSize;
+}
+
 // Memory over [begin, end) (kernel pages), replacing the reservation there: direct memory, flexible
 // memory for what direct memory did not cover (unless `flexibleToo` is false and direct memory works:
 // JavaScript's large buffers, see wtf_ps4_commit)
@@ -492,6 +494,20 @@ bool mapMemory(uintptr_t begin, uintptr_t end, int protection, const char* name,
         noteBuffersRefused(end - start);
         return false;
     }
+    if (direct) {
+        // (v00.36) No flexible memory for WebKit's pages while direct memory works. The system pool holds
+        // the kernel's own objects ("ScePthread internal memory"): after a game's WebAssembly memory and a
+        // video used up direct memory, pages committed there left the kernel none, and the PS4 ended the
+        // whole app (v00.34, v00.35). The app's pool is the one its processes share: empty, the app freezes.
+        // Refused, the commit stops this process instead (its pages say they stopped working).
+        static std::atomic<unsigned> notes { 0 };
+        if (notes.fetch_add(1, std::memory_order_relaxed) < 4)
+            fprintf(stderr, "WTF::OSAllocator (PS4): no direct memory left for %zu KiB of WebKit's pages (the pool holds %zu MiB): no flexible memory taken\n",
+                static_cast<size_t>(end - begin) >> 10, wtf_ps4_page_memory_held() >> 20);
+        if (begin > start && !returnDirectMemory(start, begin))
+            reserveAgain(start, begin);
+        return false;
+    }
     void* address = reinterpret_cast<void*>(begin);
     const size_t bytes = end - begin;
     int result = sceKernelMapNamedSystemFlexibleMemory(&address, bytes, protection, kernelMapFixed, name);
@@ -751,9 +767,26 @@ extern "C" bool wtf_ps4_commit(void* address, size_t bytes)
 // shared, each grow's new copy, other large zeroed buffers): a reservation with direct memory in it, not
 // cleared (bmalloc clears it), and only direct memory. `handled` false: no usable direct memory on this
 // console, and the caller maps memory its own way.
+namespace {
+// (v00.36) What the next large allocation on this thread commits, when less than all of it
+// (wtf_ps4_large_commit_next: a WebAssembly memory reserved to its maximum, wasm/WasmMemory.cpp)
+thread_local size_t largeCommitNext = 0;
+}
+
+extern "C" void wtf_ps4_large_commit_next(size_t bytes)
+{
+    largeCommitNext = bytes;
+}
+
+extern "C" bool wtf_ps4_direct_memory_usable()
+{
+    return useDirectMemory();
+}
+
 extern "C" void* wtf_ps4_large_allocate(size_t bytes, size_t alignment, bool* handled)
 {
     *handled = useDirectMemory();
+    const size_t commitOnly = std::exchange(largeCommitNext, 0);
     if (!*handled)
         return nullptr;
     bytes = pageUp(bytes);
@@ -767,12 +800,15 @@ extern "C" void* wtf_ps4_large_allocate(size_t bytes, size_t alignment, bool* ha
         Locker locker { poolLock };
         blockRetryIn = 0;
     }
-    const uintptr_t reached = mapDirectMemory(begin, end, kernelProtRead | kernelProtWrite, "WebKit buffers", false);
-    if (reached != end) {
+    // (cleared here: bmalloc leaves it to this; v00.36 commits only `commitOnly` when asked, the rest
+    // stays address space for wtf_ps4_commit as the buffer grows)
+    const uintptr_t commitEnd = commitOnly ? std::min<uintptr_t>(end, begin + pageUp(commitOnly)) : end;
+    const uintptr_t reached = mapDirectMemory(begin, commitEnd, kernelProtRead | kernelProtWrite, "WebKit buffers", true);
+    if (reached != commitEnd) {
         if (reached > begin)
             returnDirectMemory(begin, reached);
         sceKernelMunmap(base, bytes);
-        noteBuffersRefused(bytes);
+        noteBuffersRefused(commitEnd - begin);
         return nullptr;
     }
     return base;
