From 19fb790982e300d0b642771ca91afc8ab1d59e21 Mon Sep 17 00:00:00 2001
From: wisp <wisp@localhost>
Date: Thu, 19 Nov 2026 22:18:00 +0300
Subject: [PATCH] PS4 (Wisp): less of the memory the app's processes share:
 hidden pages give their frame buffers back, font files read instead of
 mapped, cached resources sent inline, hidden pages throttled

---
 Source/ThirdParty/skia/src/core/SkData.cpp    | 42 +++++++++++++++++++
 .../NetworkProcess/cache/NetworkCache.cpp     |  3 +-
 .../cache/NetworkCacheEntry.cpp               |  7 ++++
 .../UIProcess/API/glib/WebKitSettings.cpp     |  6 +++
 .../UIProcess/wpe/AcceleratedBackingStore.cpp |  9 +++-
 .../AcceleratedSurface.cpp                    | 18 ++++++++
 .../CoordinatedGraphics/AcceleratedSurface.h  |  4 ++
 .../NonCompositedFrameRenderer.cpp            | 16 +++++++
 .../NonCompositedFrameRenderer.h              |  4 ++
 9 files changed, 107 insertions(+), 2 deletions(-)

diff --git a/Source/ThirdParty/skia/src/core/SkData.cpp b/Source/ThirdParty/skia/src/core/SkData.cpp
index 4c853b41..8e7d8dc4 100644
--- a/Source/ThirdParty/skia/src/core/SkData.cpp
+++ b/Source/ThirdParty/skia/src/core/SkData.cpp
@@ -12,6 +12,11 @@
 #include "include/private/SkAssert.h"
 #include "include/private/SkMalloc.h"
 #include "src/core/SkOSFile.h"
+
+#if defined(__ORBIS__)
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
 #include "src/core/SkStreamPriv.h"
 
 #include <cstddef>
@@ -171,6 +176,21 @@ static void sk_mmap_releaseproc(const void* addr, void* ctx) {
 }
 
 sk_sp<SkData> SkData::MakeFromFILE(FILE* f) {
+#if defined(__ORBIS__)
+    // PS4 (Wisp): a file mapping comes out of the memory pool the app's processes share (each font a page
+    // used: 23 MiB in v00.13's web process, a CJK face alone 20 MiB); the heap is direct memory
+    {
+        const size_t length = sk_fgetsize(f);
+        if (!length) {
+            return nullptr;
+        }
+        sk_sp<SkData> data = SkData::MakeUninitialized(length);
+        if (sk_qread(f, data->writable_data(), length, 0) != length) {
+            return nullptr;
+        }
+        return data;
+    }
+#else
     size_t size;
     void* addr = sk_fmmap(f, &size);
     if (nullptr == addr) {
@@ -178,6 +198,7 @@ sk_sp<SkData> SkData::MakeFromFILE(FILE* f) {
     }
 
     return SkData::MakeWithProc(addr, size, sk_mmap_releaseproc, reinterpret_cast<void*>(size));
+#endif
 }
 
 sk_sp<SkData> SkData::MakeFromFileName(const char path[]) {
@@ -191,12 +212,33 @@ sk_sp<SkData> SkData::MakeFromFileName(const char path[]) {
 }
 
 sk_sp<SkData> SkData::MakeFromFD(int fd) {
+#if defined(__ORBIS__)
+    // PS4 (Wisp): read, not mapped (MakeFromFILE)
+    {
+        struct stat status;
+        if (fstat(fd, &status) || status.st_size <= 0) {
+            return nullptr;
+        }
+        const size_t length = static_cast<size_t>(status.st_size);
+        sk_sp<SkData> data = SkData::MakeUninitialized(length);
+        size_t done = 0;
+        while (done < length) {
+            const ssize_t n = pread(fd, static_cast<char*>(data->writable_data()) + done, length - done, static_cast<off_t>(done));
+            if (n <= 0) {
+                return nullptr;
+            }
+            done += static_cast<size_t>(n);
+        }
+        return data;
+    }
+#else
     size_t size;
     void* addr = sk_fdmmap(fd, &size);
     if (nullptr == addr) {
         return nullptr;
     }
     return SkData::MakeWithProc(addr, size, sk_mmap_releaseproc, reinterpret_cast<void*>(size));
+#endif
 }
 
 sk_sp<SkData> SkData::MakeWithCString(const char cstr[]) {
diff --git a/Source/WebKit/NetworkProcess/cache/NetworkCache.cpp b/Source/WebKit/NetworkProcess/cache/NetworkCache.cpp
