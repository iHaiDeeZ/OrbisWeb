 void ps4_heap_private_arena(const char* name) {
+    if (name) {
+        const int n = __atomic_load_n(&g_priorityNameCount, __ATOMIC_ACQUIRE);
+        for (int i = 0; i < n; i++) {
+            if (nameListed(name, &g_priorityNames[i], 1)) {
+                ps4k_scePthreadSetprio(ps4k_scePthreadSelf(), g_priorityValues[i]);
+                break;
+            }
+        }
+    }
     if (t_arena || !name)
         return;
     const bool big = nameListed(name, g_bigArenaNames, __atomic_load_n(&g_bigArenaNameCount, __ATOMIC_ACQUIRE));
