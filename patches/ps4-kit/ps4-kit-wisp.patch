+// A priority for threads by their name (OrbisWeb: WebKit's compiler threads). The PS4 runs an app's threads
+// by priority alone, with no turns among threads of one priority: six compiler threads at the default held
+// every core while a game compiled, and its own thread waited behind them; a step below the default they take
+// only the cores nothing else wants. Applied when a thread names itself (below). At most 64 patterns, kept
+// (string literals); one ending in '*' matches by prefix.
+void ps4_kit_set_thread_priority_by_name(const char* name, int priority) {
+    const int n = __atomic_load_n(&g_priorityNameCount, __ATOMIC_ACQUIRE);
+    if (!name || n >= MAX_PATTERNS)
+        return;
+    g_priorityNames[n] = name;
+    g_priorityValues[n] = clampInt(priority, 256, 767);
+    __atomic_store_n(&g_priorityNameCount, n + 1, __ATOMIC_RELEASE);
+}
+
 // Gives the calling thread a private arena if the app listed its name (called when a thread names
