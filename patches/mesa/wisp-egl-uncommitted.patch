diff --git a/src/util/rwlock.c b/src/util/rwlock.c
index 1d215d3..ff3e1ba 100644
--- a/src/util/rwlock.c
+++ b/src/util/rwlock.c
@@ -7,6 +7,81 @@
 #include <assert.h>
 #include "rwlock.h"
 
+#if defined(__PS4__)
+/* PS4 (Wisp): see rwlock.h. Readers count up in `state`; a writer holds it alone (U_RWLOCK_WRITER). A thread
+ * that cannot have it waits on the futex for `state` to change; `waiters` only spares the unlocks a wake when
+ * nobody waits (a waiter announces itself before it compares, so no wake is lost). Readers go first: a
+ * reader that already holds it never waits behind a writer. */
+#include "futex.h"
+#include <limits.h>
+
+#define U_RWLOCK_WRITER 0x80000000u
+
+int u_rwlock_init(struct u_rwlock *rwlock)
+{
+   __atomic_store_n(&rwlock->state, 0, __ATOMIC_RELAXED);
+   __atomic_store_n(&rwlock->waiters, 0, __ATOMIC_RELAXED);
+   return 0;
+}
+
+int u_rwlock_destroy(struct u_rwlock *rwlock)
+{
+   (void)rwlock;
+   return 0;
+}
+
+static void u_rwlock_wait(struct u_rwlock *rwlock, uint32_t seen)
+{
+   __atomic_fetch_add(&rwlock->waiters, 1, __ATOMIC_SEQ_CST);
+   futex_wait(&rwlock->state, (int32_t)seen, NULL);
+   __atomic_fetch_sub(&rwlock->waiters, 1, __ATOMIC_SEQ_CST);
+}
+
+static void u_rwlock_wake(struct u_rwlock *rwlock)
+{
+   if (__atomic_load_n(&rwlock->waiters, __ATOMIC_SEQ_CST))
+      futex_wake(&rwlock->state, INT32_MAX);
+}
