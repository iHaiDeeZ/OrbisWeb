+/* PS4 (OrbisWeb v00.37): the kernel's umtx wait and wake, through libkernel's _umtx_op export
+ * (OpenOrbis has no <sys/umtx.h>; the operation numbers are FreeBSD's, present since 8.0).
+ *
+ * Without futexes, every simple_mtx was a pthread mutex and every util_queue_fence a pthread mutex and
+ * condition variable. The PS4 makes those objects from a small internal pool in each process: a WebGL
+ * emulator (Star Fox 64 in EmulatorJS) made Zink and the threaded context create thousands of them
+ * (shaders, programs, pipelines, buffers, textures; several are never destroyed when futexes are
+ * missing), the pool ran out ("[ScePthread/System] Internal Memory is running out"), GStreamer's clock
+ * could not make its next mutex, and its g_error ended the process with SIGTRAP. Futexes are plain
+ * 32-bit words: no kernel object at all.
+ *
+ * Timeouts: Mesa passes an absolute CLOCK_MONOTONIC time; the kernel gets a relative timespec, which
+ * FreeBSD 9 (the PS4's base) and later both read when uaddr is its size. */
+
+#include <errno.h>
+#include <stdint.h>
+#include <time.h>
+
+int _umtx_op(void *obj, int op, unsigned long val, void *uaddr, void *uaddr2);
+
+#define PS4_UMTX_OP_WAIT_UINT_PRIVATE 15
+#define PS4_UMTX_OP_WAKE_PRIVATE 16
+
+int futex_wake(uint32_t *addr, int32_t count)
+{
+   return _umtx_op(addr, PS4_UMTX_OP_WAKE_PRIVATE, (unsigned long)(uint32_t)count, NULL, NULL) == -1 ? errno : 0;
+}
+
+int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
+{
+   struct timespec relative;
+   void *uaddr = NULL, *uaddr2 = NULL;
+
+   if (timeout != NULL) {
+      struct timespec now;
+      clock_gettime(CLOCK_MONOTONIC, &now);
+      int64_t ns = (int64_t)(timeout->tv_sec - now.tv_sec) * 1000000000 + (timeout->tv_nsec - now.tv_nsec);
+      if (ns <= 0)
+         return ETIMEDOUT;
+      relative.tv_sec = (time_t)(ns / 1000000000);
+      relative.tv_nsec = (long)(ns % 1000000000);
+      uaddr = (void *)(uintptr_t)sizeof(relative);
+      uaddr2 = &relative;
+   }
+
+   return _umtx_op(addr, PS4_UMTX_OP_WAIT_UINT_PRIVATE, (unsigned long)(uint32_t)value, uaddr, uaddr2) == -1
+             ? errno
+             : 0;
+}
