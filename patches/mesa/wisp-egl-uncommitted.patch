+int u_rwlock_rdlock(struct u_rwlock *rwlock)
+{
+   for (;;) {
+      uint32_t state = __atomic_load_n(&rwlock->state, __ATOMIC_RELAXED);
+      if (!(state & U_RWLOCK_WRITER)) {
+         if (__atomic_compare_exchange_n(&rwlock->state, &state, state + 1, 1, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+            return 0;
+         continue;
+      }
+      u_rwlock_wait(rwlock, state);
+   }
+}
+
+int u_rwlock_rdunlock(struct u_rwlock *rwlock)
+{
+   if (__atomic_sub_fetch(&rwlock->state, 1, __ATOMIC_SEQ_CST) == 0)
+      u_rwlock_wake(rwlock);
+   return 0;
+}
+
+int u_rwlock_wrlock(struct u_rwlock *rwlock)
+{
+   for (;;) {
+      uint32_t state = 0;
+      if (__atomic_compare_exchange_n(&rwlock->state, &state, U_RWLOCK_WRITER, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+         return 0;
+      u_rwlock_wait(rwlock, state);
+   }
+}
+
+int u_rwlock_wrunlock(struct u_rwlock *rwlock)
+{
+   __atomic_store_n(&rwlock->state, 0, __ATOMIC_SEQ_CST);
+   u_rwlock_wake(rwlock);
+   return 0;
+}
